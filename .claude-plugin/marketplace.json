{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "ben-plugins",
  "description": "ben 的 Claude Code 插件集合，包含个人研发流程等自定义插件",
  "owner": {
    "name": "ben",
    "email": "benbowenqwe@gmail.com"
  },
  "plugins": [
    {
      "name": "dev-flow",
      "description": "个人研发流程插件：从 PRD 到交付的完整 8 步工作流，自动编排需求分析、提问对齐、技术方案、编码、自测、CR、总结",
      "author": {
        "name": "ben",
        "email": "benbowenqwe@gmail.com"
      },
      "source": "./plugins/dev-flow",
      "category": "development",
      "homepage": "https://github.com/Today-Hbw/ben-plugins/tree/main/plugins/dev-flow"
    },
    {
      "name": "dev-flow-lite",
      "description": "简版研发流程插件：读 PRD → 提问对齐 → 编码 → Code Review，不写 MD、不做断点续传，适合小需求快速迭代",
      "author": {
        "name": "ben",
        "email": "benbowenqwe@gmail.com"
      },
      "source": "./plugins/dev-flow-lite",
      "category": "development",
      "homepage": "https://github.com/Today-Hbw/ben-plugins/tree/main/plugins/dev-flow-lite"
    },
    {
      "name": "forge-prd",
      "description": "从任何原料（粗略想法、图片、PDF、HTML、MD）通过三层递进式强势拷问锻造出一份清晰可用的 PRD，输出 MD 文件",
      "author": {
        "name": "ben",
        "email": "benbowenqwe@gmail.com"
      },
      "source": "./plugins/forge-prd",
      "category": "development",
      "homepage": "https://github.com/Today-Hbw/ben-plugins/tree/main/plugins/forge-prd"
    }
  ]
}
